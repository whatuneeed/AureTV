<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#071A3D"
                android:centerColor="#070B22"
                android:endColor="#0D0722" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/aure_splash" />
    </item>
</layer-list>
