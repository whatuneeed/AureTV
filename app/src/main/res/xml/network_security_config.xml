<?xml version="1.0" encoding="utf-8"?>
<!-- Every host uses TLS. The screen saver's old cleartext path to Apple's CDN
     was removed: media is HTTPS-first and has no silent HTTP fallback, so a
     network that blocks 443 falls back to the stills-only saver instead of
     serving untrusted bytes. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
