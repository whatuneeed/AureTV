<?xml version="1.0" encoding="utf-8"?>
<!-- Every host uses TLS. The one exception is Apple's public Aerial CDN:
     some TV trust stores reject Apple's certificate chain, so the clips and
     stills are fetched over HTTP from this single host. The videos carry no
     account, token or personal data. Do not widen this exception. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
